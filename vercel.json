{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/youtube.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(CSS|js|data)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
